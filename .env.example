# ============================================================
#  .env.example — 環境變數「名」嘅唯一清單（A1 / F12 / VL2）
# ------------------------------------------------------------
#  ⚠️ 呢個檔只可以有 key 名，唔可以有任何真實值。
#     真值只住喺：Vercel → Settings → Environment Variables
#                （本機開發：cp .env.example .env.local 之後自己填）
#     .env.local 已被 .gitignore 排除；千祈唔好 commit。
#
#  本機預覽：node dev-server.mjs 會自動載入 .env.local，
#            咁旅團選擇閘就同 Vercel 生產環境一樣。
#
#  變數名嘅來源（單一真理）：api/_registry.js / api/auth.js /
#  api/portal.js / api/share.js / api/proxy.js / api/progress.js。
#  改咗嗰檔就要一齊改呢度（F16）。
# ============================================================

# ---- ① 每個旅團一組（TROOP_<編號>_…）-------------------------
# 編號 = data/units.json 登記咗嗰個（例：0082）。
# 82 / 082 / 0082 視為同一旅團，但 env 名建議用登記咗個寫法。
# 後端網址只接受 https://script.google.com/macros/s/…/exec
#（唔接受 /dev、唔接受其他網域 —— api/_registry.js 會擋）。
TROOP_0082_NAME=
TROOP_0082_BACKEND=
TROOP_0082_APIKEY=

# 上面三個值必須與 BADGE 完全相同。管理系統、進度、中央入口交換票及 BADGE
# 全部沿用同一 Unified GAS／Sheet；不要另設 PROGRESS*、PORTAL* 或 SSO secret。
# APIKEY 只作 server routing 及用途分隔 HMAC 根，不直接代表任何用戶身份。

# ---- ② 隱藏超管（A14；fail closed）---------------------------
# 帳號名固定係 sheep（api/auth.js SUPER_ADMIN，唔係可配置帳戶）。
# 冇設 SUPER_KEY = 超管登入整條路關閉（唔會用預設密碼放行）。
# 只喺伺服器端使用，永遠唔會回應畀前端。
SUPER_KEY=

# ---- ③ 公開網址 ----------------------------------------------
# PUBLIC_APP_ORIGIN：產生分享連結／QR 用嘅公開 origin。
#                    冇設就用請求嘅 host 推斷。
PUBLIC_APP_ORIGIN=

# ---- ④ ADMIN 收件匣（可選覆蓋）------------------------------
# 新旅團申請接入嘅目的地。程式內已有固定常數 SCOUT_ADMIN_API，
# 只有要指向另一個收件匣先設呢個（固定受信端點，唔接受由前端傳入）。
SCOUT_ADMIN_API=

# ---- ⑤ 調優／測試（可選，全部有安全預設）--------------------
# 代理逾時（毫秒）；回應大小上限由 V82_NO_RESPONSE_LIMIT 控制。
V82_PROXY_TIMEOUT_MS=
V82_PROGRESS_TIMEOUT_MS=
V82_NO_RESPONSE_LIMIT=
# 下面兩個只供自動化測試用，生產環境唔好設：
V82_PROXY_TEST=
VSBADGE_PROXY_TEST=

# ---- ⑥ 本機開發伺服器 ---------------------------------------
PORT=8000
HOST=0.0.0.0

# ============================================================
#  換 API Key = 三處同步（F16，漏一處就會靜靜打唔通）：
#    ① 下游 Apps Script：刪 ScriptProperties 嘅 API_KEY → 跑 showApiKey() 生新 key
#    ② 上游（如有旅系統）：重新登記該下游
#    ③ 呢度對應嘅 Vercel env → Redeploy
# ============================================================
